# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Copy this file to .env.local and replace values with your Firebase project's settings.
# These two point at the POS app (default port 3000), which owns business
# settings and the branch list. This app proxies them through its own
# /api/settings and /api/shops routes — so pointing these at this app's own port
# would make those routes fetch themselves.
NEXT_PUBLIC_SETTINGS_API_URL=http://localhost:3000/api/settings
NEXT_PUBLIC_SHOPS_API_URL=http://localhost:3000/api/shops
NEXT_PUBLIC_NEW_ITEM_DAYS=7

# MyanMyanPay
MMPAY_MODE=sandbox
MMPAY_API_BASE_URL=https://ezapi.myanmyanpay.com
MMPAY_APP_ID=mmpay_app_id
MMPAY_PUBLISHABLE_KEY=your_publishable_key
MMPAY_SECRET_KEY=your_secret_key
MMPAY_RETURN_URL=http://localhost:3001/checkout?status=success
MMPAY_CANCEL_URL=http://localhost:3001/checkout?status=cancel
MMPAY_CALLBACK_URL=http://localhost:3001/api/mmpay/webhook

# Firebase Admin (for secure server-side webhook/order updates)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Public base URL of THIS app (the customer storefront, default port 3001).
# Used to build customer-facing links in outgoing email and Telegram messages —
# /account/purchases, /membership, /view-all, /account/link-telegram. Those pages
# only exist here, so this must never point at the POS app on port 3000.
# No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional shared rate fallback
NEXT_PUBLIC_MMK_RATE=55

# Groq API Configuration (for AI Shopping Assistant - FREE & ULTRA FAST!)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
#
# DELIVERY MODE. A bot token has exactly one, globally:
#   - Local dev  -> long polling: `npm run telegram:dev`. TELEGRAM_WEBHOOK_URL is
#     unused, and the script unregisters any webhook while it runs.
#   - Deployed   -> webhook. Serverless platforms such as Vercel cannot run the
#     polling script, because it needs a process that stays alive.
# The two cannot both be active on one token: starting the local poller takes the
# bot away from production until you re-register the webhook.
#
# Must be public HTTPS — Telegram rejects http:// and localhost.
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Telegram sends this back on every webhook call, and it also authorises
# /api/telegram/setup-webhook?secret=...
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
# Optional: Admin chat ID for admin notifications
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Customer email verification (Gmail SMTP)
# GMAIL_APP_PASSWORD must be a 16-character Google App Password, NOT the
# account password. Requires 2-Step Verification on the sending account:
# https://myaccount.google.com/apppasswords
# Spaces in the app password are ignored, so "abcd efgh ijkl mnop" is fine.
GMAIL_USER=your_shop_account@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Display name used in the From header of outgoing emails
EMAIL_FROM_NAME=SWE TRENDY HUB


# Customer Notification Service (shared secret)
# Guards POST /api/notifications/dispatch and POST /api/notifications/broadcast,
# which the POS app calls to email and Telegram-message customers. One broadcast
# can reach the entire customer list, so these routes refuse every request when
# this value is unset.
# Must be identical to NOTIFY_API_SECRET in the POS app's .env.local.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFY_API_SECRET=your_shared_notification_secret
